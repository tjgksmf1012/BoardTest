  <script>
    // 화면 테마 전환: 밝게 ↔ 어둡게. 고른 값은 기기에 저장해 다음에도 유지된다.
    (function () {
      var btn = document.getElementById('themeBtn');
      if (!btn) return;
      var mq = window.matchMedia('(prefers-color-scheme: dark)');
      function isDark() {
        var t = document.documentElement.getAttribute('data-theme');
        return t ? t === 'dark' : mq.matches;
      }
      function label() {
        btn.title = btn.setAttribute('aria-label', isDark() ? '밝은 화면으로 바꾸기' : '어두운 화면으로 바꾸기');
        btn.title = isDark() ? '밝은 화면으로 바꾸기' : '어두운 화면으로 바꾸기';
      }
      btn.addEventListener('click', function () {
        var next = isDark() ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('pl-theme', next); } catch (e) {}
        label();
      });
      // 직접 고른 적이 없으면 기기 설정이 바뀔 때 따라간다
      mq.addEventListener('change', label);
      label();
    })();
  </script>

  <script>
    // 점 3개(더보기) 메뉴 — 글·댓글마다 하나씩 있어서 각각에 거는 대신
    // 문서 전체에서 클릭을 한 번만 받아 처리한다.
    (function () {
      function closeAll(except) {
        document.querySelectorAll('.menu-pop').forEach(function (pop) {
          if (pop === except) return;
          pop.hidden = true;
          var btn = pop.parentNode.querySelector('.menu-btn');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        });
      }
      document.addEventListener('click', function (e) {
        var btn = e.target.closest && e.target.closest('.menu-btn');
        if (btn) {
          var pop = btn.parentNode.querySelector('.menu-pop');
          var opening = pop.hidden;
          closeAll(pop);
          pop.hidden = !opening;
          btn.setAttribute('aria-expanded', opening ? 'true' : 'false');
          if (opening) {
            // 화면 오른쪽으로 삐져나가면 왼쪽으로 붙인다
            pop.style.right = '0';
            pop.style.left = 'auto';
            var r = pop.getBoundingClientRect();
            if (r.left < 4) { pop.style.right = 'auto'; pop.style.left = '0'; }
          }
          return;
        }
        // 메뉴 안을 누른 게 아니면 닫는다
        if (!(e.target.closest && e.target.closest('.menu-pop'))) closeAll(null);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        var open = document.querySelector('.menu-pop:not([hidden])');
        if (!open) return;
        var btn = open.parentNode.querySelector('.menu-btn');
        closeAll(null);
        if (btn) btn.focus();
      });
    })();
  </script>

  <script>
    // 필수 입력 안내 문구를 한글로 (브라우저 기본 영어 메시지 대체)
    document.querySelectorAll('input[required], textarea[required]').forEach(function (el) {
      el.addEventListener('invalid', function () {
        if (!el.value) el.setCustomValidity('이 항목을 입력해주세요.');
      });
      el.addEventListener('input', function () { el.setCustomValidity(''); });
    });
  </script>

  <button class="to-top" id="toTop" type="button" aria-label="맨 위로" hidden><%- icon('arrowUp', 22) %></button>
  <script>
    (function () {
      var btn = document.getElementById('toTop');
      if (!btn) return;
      function toggle() { btn.hidden = window.scrollY < 500; }
      window.addEventListener('scroll', toggle, { passive: true });
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      btn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }); });
      toggle();
    })();
  </script>

