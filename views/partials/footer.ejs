  </main>
  <footer class="footer">
    <p>포인트라운지 · 활동할수록 포인트가 쌓이고 아바타가 성장하는 커뮤니티</p>
  </footer>

  <% if (me && attendanceDue) { %>
    <%# 그날 첫 접속 때 한 번만 뜨는 출석 팝업. 출석하거나 닫으면 그날은 다시 뜨지 않는다 %>
    <div class="att-pop" id="attPop" hidden>
      <div class="att-pop-card" role="dialog" aria-modal="true" aria-labelledby="attPopTitle">
        <button class="att-pop-x" id="attPopClose" type="button" aria-label="닫기">&times;</button>
        <p class="att-pop-eyebrow"><%- icon('calendar', 15) %> 오늘의 출석</p>
        <h2 id="attPopTitle">출석하고 <strong>100P</strong> 받아가세요</h2>
        <% if (attendanceStreak > 0) { %>
          <p class="att-pop-sub">
            <%- icon('flame', 15) %> <strong><%= attendanceStreak %>일</strong> 연속 출석 중이에요.
            오늘 출석하면 <strong><%= attendanceStreak + 1 %>일째</strong>!
          </p>
        <% } else { %>
          <p class="att-pop-sub">매일 출석하면 3·7·30일마다 보너스 포인트를 더 받아요.</p>
        <% } %>
        <form action="/attendance/check" method="post">
          <input type="hidden" name="next" value="<%= currentPath %>">
          <button class="btn btn-primary btn-block" type="submit">출석체크 하고 100P 받기</button>
        </form>
        <button class="att-pop-later" id="attPopLater" type="button">오늘은 그냥 둘러볼게요</button>
      </div>
    </div>
    <script>
      (function () {
        var pop = document.getElementById('attPop');
        if (!pop) return;
        var key = 'pl-att-<%= todayKey %>'; // 날짜가 바뀌면 키도 바뀌어 다음 날 다시 뜬다
        try { if (localStorage.getItem(key)) return; } catch (e) {}
        function close() {
          pop.hidden = true;
          try { localStorage.setItem(key, '1'); } catch (e) {}
        }
        pop.hidden = false;
        document.getElementById('attPopClose').addEventListener('click', close);
        document.getElementById('attPopLater').addEventListener('click', close);
        pop.addEventListener('click', function (e) { if (e.target === pop) close(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !pop.hidden) close(); });
      })();
    </script>
  <% } %>

  <script>
    // 필수 입력 안내 문구를 한글로 (브라우저 기본 영어 메시지 대체)
    document.querySelectorAll('input[required], textarea[required]').forEach(function (el) {
      el.addEventListener('invalid', function () {
        if (!el.value) el.setCustomValidity('이 항목을 입력해주세요.');
      });
      el.addEventListener('input', function () { el.setCustomValidity(''); });
    });
  </script>

  <button class="to-top" id="toTop" type="button" aria-label="맨 위로" hidden><%- icon('arrowUp', 22) %></button>
  <script>
    (function () {
      var btn = document.getElementById('toTop');
      if (!btn) return;
      function toggle() { btn.hidden = window.scrollY < 500; }
      window.addEventListener('scroll', toggle, { passive: true });
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      btn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }); });
      toggle();
    })();
  </script>

  <!-- 모바일 하단 탭바 -->
  <nav class="bottom-nav">
    <a href="/board" class="bn-item <%= (typeof active !== 'undefined' && active === 'board') ? 'on' : '' %>">
      <span class="bn-ico"><%- icon('home', 22) %></span><span>홈</span>
    </a>
    <a href="/points" class="bn-item <%= (typeof active !== 'undefined' && active === 'points') ? 'on' : '' %>">
      <span class="bn-ico"><%- icon('coin', 22) %></span><span>포인트</span>
    </a>
    <a href="/board/new" class="bn-item bn-write">
      <span class="bn-ico"><%- icon('pencil', 22) %></span><span>글쓰기</span>
    </a>
    <a href="/ranking" class="bn-item <%= (typeof active !== 'undefined' && active === 'ranking') ? 'on' : '' %>">
      <span class="bn-ico"><%- icon('trophy', 22) %></span><span>랭킹</span>
    </a>
    <a href="/profile" class="bn-item <%= (typeof active !== 'undefined' && active === 'profile') ? 'on' : '' %>">
      <span class="bn-ico"><%- icon('user', 22) %></span><span>MY</span>
    </a>
  </nav>
</body>
</html>
