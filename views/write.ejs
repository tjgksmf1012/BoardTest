<%- include('partials/header', { title: post ? '글 수정' : '글쓰기', active: 'board' }) %>

<div class="card write-card">
  <h1><%= post ? '글 수정' : '글쓰기' %></h1>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>

  <form method="post" enctype="multipart/form-data"
        action="<%= post ? '/board/' + post.id + '/edit' : '/board' %>" class="form">
    <label><span>말머리 <span class="req">*</span></span>
      <select name="category" class="cat-select">
        <% categories.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= (post ? post.category === c.id : c.id === '자유') ? 'selected' : '' %>><%= c.id %></option>
        <% }) %>
      </select>
    </label>
    <label><span>제목 <span class="req">*</span></span>
      <input type="text" name="title" maxlength="50" required
             placeholder="제목을 입력해주세요 (50자 이내)"
             value="<%= post ? post.title : '' %>"
             oninput="counter(this, 'title-count', 50)">
      <span class="count" id="title-count"><%= post ? post.title.length : 0 %> / 50</span>
    </label>

    <label><span>내용 <span class="req">*</span></span>
      <textarea name="content" rows="12" maxlength="5000" required
                placeholder="내용을 입력해주세요 (5,000자 이내)"
                oninput="counter(this, 'content-count', 5000)"><%= post ? post.content : '' %></textarea>
      <span class="count" id="content-count"><%= post ? post.content.length : 0 %> / 5,000</span>
    </label>

    <div class="file-field">
      <span class="file-label">사진 첨부 <span class="muted">(선택 · 최대 5장 · JPG, PNG · 장당 10MB 이하)</span></span>
      <label class="file-btn" for="image-input"><%- icon('image', 16) %> 사진 선택하기</label>
      <input type="file" id="image-input" name="images" accept="image/jpeg,image/png" multiple hidden>
    </div>

    <% if (post && images && images.length > 0) { %>
      <div class="img-previews" id="existing-previews">
        <% images.forEach(function (img) { %>
          <div class="img-preview" data-existing="1">
            <img src="/uploads/<%= img.filename %>" alt="첨부 이미지">
            <label class="img-remove-check" title="삭제">
              <input type="checkbox" name="remove_images" value="<%= img.id %>"
                     onchange="this.closest('.img-preview').classList.toggle('removing', this.checked)">✕
            </label>
          </div>
        <% }) %>
      </div>
    <% } %>
    <div class="img-previews" id="new-previews"></div>

    <div class="write-options">
      <% if (!post) { %>
        <label class="check"><input type="checkbox" name="is_anonymous">
          익명으로 작성 <span class="muted">(닉네임 대신 익명으로 표시, 추천 비활성화, +100P)</span></label>
      <% } %>
      <label class="check"><input type="checkbox" name="block_comments"
        <%= post && post.block_comments ? 'checked' : '' %>>
        댓글 차단 <span class="muted">(다른 회원이 댓글을 달 수 없어요)</span></label>
      <% if (!post && me && me.is_admin) { %>
        <label class="check"><input type="checkbox" name="is_notice"> 공지로 등록 (운영자)</label>
      <% } %>
    </div>

    <div class="write-actions">
      <a class="btn btn-ghost" href="<%= post ? '/board/' + post.id : '/board' %>">취소</a>
      <button class="btn btn-primary" type="submit"><%= post ? '수정하기' : '등록하기' %></button>
    </div>
  </form>
</div>

<script>
  function counter(el, id, max) {
    document.getElementById(id).textContent = el.value.length + ' / ' + max.toLocaleString();
  }

  // 이미지 첨부 미리보기 + 개별 삭제 (DataTransfer로 FileList 재구성)
  var imageInput = document.getElementById('image-input');
  var selectedFiles = [];

  imageInput.addEventListener('change', function () {
    var existing = document.querySelectorAll('#existing-previews .img-preview:not(.removing)').length;
    var incoming = Array.from(imageInput.files);
    for (var i = 0; i < incoming.length; i++) {
      if (selectedFiles.length + existing >= 5) { alert('사진은 최대 5장까지 첨부할 수 있어요.'); break; }
      if (incoming[i].size > 10 * 1024 * 1024) { alert(incoming[i].name + ' 은(는) 10MB를 넘어 첨부할 수 없어요.'); continue; }
      selectedFiles.push(incoming[i]);
    }
    syncFiles();
  });

  function removeNewImage(idx) {
    selectedFiles.splice(idx, 1);
    syncFiles();
  }

  function syncFiles() {
    var dt = new DataTransfer();
    selectedFiles.forEach(function (f) { dt.items.add(f); });
    imageInput.files = dt.files;

    var box = document.getElementById('new-previews');
    box.innerHTML = '';
    selectedFiles.forEach(function (f, idx) {
      var div = document.createElement('div');
      div.className = 'img-preview';
      var img = document.createElement('img');
      img.src = URL.createObjectURL(f);
      img.onload = function () { URL.revokeObjectURL(img.src); };
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'img-remove-check';
      btn.textContent = '✕';
      btn.title = '삭제';
      btn.onclick = function () { removeNewImage(idx); };
      div.appendChild(img);
      div.appendChild(btn);
      box.appendChild(div);
    });
  }
</script>

<%- include('partials/footer') %>
