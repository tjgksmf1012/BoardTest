<%- include('partials/header', { title: '신고 관리', active: null }) %>

<div class="board-head">
  <div>
    <h1>신고 관리 <span class="badge badge-notice">운영자</span></h1>
    <p class="muted">신고가 접수된 게시글이에요. 확인 후 필요하면 숨김(삭제) 처리하세요.</p>
  </div>
</div>

<div class="card post-list">
  <% if (items.length === 0) { %>
    <div class="empty">신고된 게시글이 없어요. 👍</div>
  <% } else { %>
    <% items.forEach(function (p) { %>
      <div class="post-row report-row">
        <span class="report-count"><%- icon('report', 16) %> <%= p.report_count %></span>
        <a class="post-mid" href="/board/<%= p.id %>">
          <div class="post-title"><%- catTag(p.category) %> <%= p.title %></div>
          <div class="post-meta">
            작성자 <%= p.is_anonymous ? '익명' : p.nickname %> · 최근 신고 <%= p.last_reported.slice(0, 16) %>
          </div>
        </a>
        <div class="report-acts">
          <a class="btn btn-ghost btn-sm" href="/board/<%= p.id %>">보기</a>
          <form action="/board/<%= p.id %>/delete" method="post" class="inline"
                onsubmit="return confirm('이 게시글을 삭제(숨김 처리)할까요?')">
            <input type="hidden" name="back" value="reports">
            <button class="btn btn-ghost btn-sm danger" type="submit">삭제</button>
          </form>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<%- include('partials/footer') %>
