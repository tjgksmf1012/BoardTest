<%- include('partials/header', { title: post.title, active: 'board' }) %>

<article class="card post-detail">
  <div class="post-detail-head">
    <h1>
      <% if (post.is_notice) { %><span class="badge badge-notice">공지</span><% } else { %><%- catTag(post.category) %><% } %>
      <% if (post.is_popular) { %><span class="badge badge-hot">인기</span><% } %>
      <% if (post.admin_picked) { %><span class="badge badge-pick">운영자 추천</span><% } %>
      <% if (post.is_hidden) { %><span class="badge badge-lock">숨김</span><% } %>
      <%= post.title %>
    </h1>
    <% if (post.is_hidden && me && me.is_admin) { %>
      <div class="hidden-note">이 글은 숨김 처리되어 일반 회원에게 보이지 않아요.</div>
    <% } %>
    <div class="post-author">
      <% if (post.is_anonymous) { %>
        <%- renderAvatar('basic-12', null, 44) %>
        <div><strong>익명</strong><br><span class="muted"><%= post.created_at.slice(0, 16) %> · 조회 <%= post.views %></span></div>
      <% } else { %>
        <a class="author-link" href="/users/<%= post.user_id %>" aria-label="<%= post.nickname %>님 프로필"><%- renderAvatar(post.avatar_id, post.border_id, 44) %></a>
        <div><a class="author-link" href="/users/<%= post.user_id %>"><strong><%= post.nickname %></strong></a> <%- levelBadge(post.author_points) %><br><span class="muted"><%= post.created_at.slice(0, 16) %> · 조회 <%= post.views %></span></div>
      <% } %>
      <div class="spacer"></div>
      <span class="muted post-head-stats"><%- icon('comment', 15) %> <%= commentCount %> · <%- icon('like', 15) %> <%= post.like_count %></span>

      <%# 신고·수정·삭제·운영자 기능은 자주 쓰지 않는데 버튼으로 늘어놓으면 본문보다 눈에 띈다.
          기획안대로 점 3개 안에 모아, 밖에는 목록·스크랩·추천만 남긴다. %>
      <% if (me && (me.id === post.user_id || me.is_admin || !post.is_notice)) { %>
        <div class="menu">
          <button class="menu-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="글 더보기">
            <%- icon('more', 18) %>
          </button>
          <div class="menu-pop" role="menu" hidden>
            <% if (me.id === post.user_id) { %>
              <a class="menu-item" role="menuitem" href="/board/<%= post.id %>/edit">수정하기</a>
            <% } %>
            <% if (me.id === post.user_id || me.is_admin) { %>
              <form action="/board/<%= post.id %>/delete" method="post"
                    onsubmit="return confirm('정말 삭제할까요?')"><%- csrfField() %>
                <button class="menu-item danger" role="menuitem" type="submit">삭제하기</button>
              </form>
            <% } %>
            <% if (!post.is_notice && me.id !== post.user_id) { %>
              <form action="/board/<%= post.id %>/report" method="post"><%- csrfField() %>
                <button class="menu-item" role="menuitem" type="submit">신고하기</button>
              </form>
            <% } %>
            <% if (me.is_admin && !post.is_notice) { %>
              <div class="menu-sep" role="separator">운영자</div>
              <% if (!post.admin_picked) { %>
                <form action="/board/<%= post.id %>/admin-pick" method="post"><%- csrfField() %>
                  <button class="menu-item" role="menuitem" type="submit">운영자 추천</button>
                </form>
              <% } %>
              <form action="/board/<%= post.id %>/hide" method="post"><%- csrfField() %>
                <button class="menu-item" role="menuitem" type="submit"><%= post.is_hidden ? '숨김 해제' : '숨김 처리' %></button>
              </form>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <% if (post.content_format === 'html') { %>
    <%# 저장 시 정화(sanitize)된 HTML — 사진이 본문 안 원하는 위치에 들어간다 %>
    <div class="post-body rich"><%- post.content %></div>
  <% } else { %>
    <div class="post-body"><%= post.content %></div>
    <% if (images.length > 0) { %>
      <div class="post-images">
        <% images.forEach(function (img) { %>
          <img src="/uploads/<%= img.filename %>" alt="첨부 이미지" loading="lazy">
        <% }) %>
      </div>
    <% } %>
  <% } %>

  <div class="post-actions">
    <a class="btn btn-ghost" href="/board">목록</a>
    <div class="spacer"></div>

    <% if (me) { %>
      <form action="/board/<%= post.id %>/bookmark" method="post" class="inline"><%- csrfField() %>
        <button class="btn btn-ghost <%= bookmarked ? 'active' : '' %>" type="submit">
          <%- icon('bookmark', 16) %> <%= bookmarked ? '스크랩됨' : '스크랩' %>
        </button>
      </form>
    <% } %>

    <% if (post.is_anonymous) { %>
      <button class="btn btn-like" disabled title="익명글은 추천이 비활성화돼요"><%- icon('like', 16) %> 추천 불가</button>
    <% } else if (liked) { %>
      <button class="btn btn-like liked" disabled><%- icon('like', 16) %> 추천 완료 <%= post.like_count %></button>
    <% } else { %>
      <form action="/board/<%= post.id %>/like" method="post" class="inline"><%- csrfField() %>
        <button class="btn btn-like" type="submit"><%- icon('like', 16) %> 추천 <%= post.like_count %></button>
      </form>
    <% } %>
  </div>
</article>

<section class="card comments" id="comments">
  <h2>댓글 <span class="accent"><%= commentCount %></span></h2>

  <% if (post.block_comments) { %>
    <div class="empty">작성자가 댓글을 차단한 게시글이에요.</div>
  <% } else { %>
    <% if (best && best.length > 0) { %>
      <div class="best-block">
        <% best.forEach(function (c) { %>
          <%- include('partials/comment', { c: c, post: post, me: me, isBest: true }) %>
        <% }) %>
      </div>
    <% } %>

    <% const REPLY_HEAD = 2; // 답글이 많으면 앞 2개만 보이고 나머지는 접어둔다 %>
    <% comments.forEach(function (c) { %>
      <%- include('partials/comment', { c: c, post: post, me: me, isBest: false }) %>
      <% c.replies.slice(0, REPLY_HEAD).forEach(function (r) { %>
        <%- include('partials/comment', { c: r, post: post, me: me, isBest: false }) %>
      <% }) %>
      <% if (c.replies.length > REPLY_HEAD) { %>
        <div class="reply-more-wrap" id="more-<%= c.id %>">
          <button class="reply-more" type="button" onclick="showMoreReplies(<%= c.id %>)">
            답글 <%= c.replies.length - REPLY_HEAD %>개 더 보기
          </button>
        </div>
        <div class="reply-rest" id="rest-<%= c.id %>" hidden>
          <% c.replies.slice(REPLY_HEAD).forEach(function (r) { %>
            <%- include('partials/comment', { c: r, post: post, me: me, isBest: false }) %>
          <% }) %>
        </div>
      <% } %>
    <% }) %>

    <% if (cTotalPages > 1) { %>
      <%
        const cw = 2;
        let cf = Math.max(1, cPage - cw), ct = Math.min(cTotalPages, cPage + cw);
        if (cPage <= cw + 1) ct = Math.min(cTotalPages, cw * 2 + 1);
        if (cPage >= cTotalPages - cw) cf = Math.max(1, cTotalPages - cw * 2);
        const chref = (n) => `/board/${post.id}` + (n > 1 ? `?cpage=${n}` : '') + '#comments';
      %>
      <nav class="pager comment-pager" aria-label="댓글 페이지 이동">
        <% if (cPage > 1) { %>
          <a class="page page-nav" href="<%= chref(cPage - 1) %>" rel="prev" aria-label="이전 댓글">‹</a>
        <% } %>
        <% if (cf > 1) { %><span class="page-gap">…</span><% } %>
        <% for (let i = cf; i <= ct; i++) { %>
          <a class="page <%= i === cPage ? 'on' : '' %>" href="<%= chref(i) %>"
             <%= i === cPage ? 'aria-current="page"' : '' %>><%= i %></a>
        <% } %>
        <% if (ct < cTotalPages) { %><span class="page-gap">…</span><% } %>
        <% if (cPage < cTotalPages) { %>
          <a class="page page-nav" href="<%= chref(cPage + 1) %>" rel="next" aria-label="다음 댓글">›</a>
        <% } %>
        <span class="page-info muted"><%= cPage %> / <%= cTotalPages %></span>
      </nav>
    <% } %>

    <% if (me) { %>
      <form action="/board/<%= post.id %>/comments" method="post" class="comment-form"><%- csrfField() %>
        <input type="text" name="content" placeholder="댓글을 입력해주세요 (+100P, 하루 10개까지)" required maxlength="1000">
        <button class="btn btn-primary" type="submit">등록</button>
      </form>
    <% } else { %>
      <div class="empty"><a href="/login">로그인</a>하고 댓글을 남겨보세요.</div>
    <% } %>
  <% } %>
</section>

<div class="prev-next">
  <% if (next) { %>
    <a class="pn" href="/board/<%= next.id %>"><span class="muted">다음글</span> <%= next.title %></a>
  <% } %>
  <% if (prev) { %>
    <a class="pn" href="/board/<%= prev.id %>"><span class="muted">이전글</span> <%= prev.title %></a>
  <% } %>
</div>

<script>
  function toggleReply(id) {
    var f = document.getElementById('reply-' + id);
    f.hidden = !f.hidden;
    if (!f.hidden) f.querySelector('input[name="content"]').focus();
  }

  // 댓글 수정: 본문을 감추고 입력칸을 보여준다
  function toggleEdit(id) {
    var text = document.getElementById('ctext-' + id);
    var form = document.getElementById('cedit-' + id);
    var acts = document.getElementById('cacts-' + id);
    if (!form) return;
    var editing = form.hidden;
    form.hidden = !editing;
    text.hidden = editing;
    if (acts) acts.hidden = editing;
    if (editing) {
      var input = form.querySelector('input[name="content"]');
      input.focus();
      input.setSelectionRange(input.value.length, input.value.length);
    }
  }

  // 접어둔 답글 펼치기
  function showMoreReplies(id) {
    document.getElementById('rest-' + id).hidden = false;
    document.getElementById('more-' + id).hidden = true;
  }
</script>

<%- include('partials/footer') %>
