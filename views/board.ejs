<%- include('partials/header', { title: '커뮤니티', active: 'board' }) %>

<div class="board-head">
  <div>
    <h1>커뮤니티</h1>
    <p class="muted">일상 이야기부터 고민까지 편하게 나누는 공간이에요. 글을 쓰면 포인트가 쌓여요!</p>
  </div>
  <a class="btn btn-primary" href="/board/new"><%- icon('pencil', 18) %> 글쓰기</a>
</div>

<form class="search" method="get" action="/board">
  <span class="search-ico"><%- icon('search', 18) %></span>
  <input type="text" name="q" value="<%= q %>" placeholder="제목이나 내용으로 검색">
  <% if (sort !== 'latest') { %><input type="hidden" name="sort" value="<%= sort %>"><% } %>
  <% if (hot) { %><input type="hidden" name="filter" value="hot"><% } %>
  <button class="btn btn-ghost" type="submit">검색</button>
</form>

<% if (trending && trending.length > 0) { %>
  <div class="card trending">
    <div class="trending-head"><%- icon('flame', 18) %> 지금 뜨는 글</div>
    <ol class="trending-list">
      <% trending.forEach(function (t, i) { %>
        <li><a href="/board/<%= t.id %>">
          <span class="tr-rank"><%= i + 1 %></span>
          <span class="tr-title"><%= t.title %></span>
          <span class="tr-like"><%- icon('like', 15) %> <%= t.like_count %></span>
        </a></li>
      <% }) %>
    </ol>
  </div>
<% } %>

<div class="cat-chips">
  <a class="chip <%= !category && !hot ? 'on' : '' %>" href="/board?sort=<%= sort %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">전체</a>
  <% categories.forEach(function (c) { %>
    <a class="chip <%= category === c.id ? 'on' : '' %>"
       href="/board?category=<%= encodeURIComponent(c.id) %>&sort=<%= sort %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"><%= c.id %></a>
  <% }) %>
</div>

<div class="filter-bar">
  <div class="chips">
    <a class="chip <%= !hot ? 'on' : '' %>" href="/board?<%= category ? 'category=' + encodeURIComponent(category) + '&' : '' %>sort=<%= sort %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">전체글</a>
    <a class="chip <%= hot ? 'on' : '' %>" href="/board?filter=hot&sort=<%= sort %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">인기글</a>
  </div>
  <div class="chips">
    <% ['latest', 'likes', 'views'].forEach(function (s) { %>
      <a class="chip <%= sort === s ? 'on' : '' %>"
         href="/board?sort=<%= s %><%= category ? '&category=' + encodeURIComponent(category) : '' %><%= hot ? '&filter=hot' : '' %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">
        <%= s === 'latest' ? '최신순' : s === 'likes' ? '추천순' : '조회순' %>
      </a>
    <% }) %>
  </div>
</div>

<div class="post-list card">
  <% notices.forEach(function (p) { %>
    <a class="post-row notice" href="/board/<%= p.id %>">
      <%- renderAvatar(p.avatar_id, p.border_id, 46) %>
      <div class="post-mid">
        <div class="post-title"><span class="badge badge-notice">공지</span> <%= p.title %></div>
        <div class="post-meta"><%= p.nickname %> · <%= p.created_at.slice(0, 10) %></div>
      </div>
      <div class="post-stats">👁 <%= p.views.toLocaleString() %></div>
    </a>
  <% }) %>

  <% if (posts.length === 0) { %>
    <div class="empty">
      <% if (q) { %>
        '<%= q %>' 검색 결과가 없어요.
      <% } else if (category) { %>
        아직 '<%= category %>' 글이 없어요. 첫 글을 써보세요!
      <% } else { %>
        아직 게시글이 없어요. 첫 글을 써보세요!
      <% } %>
    </div>
  <% } %>

  <% posts.forEach(function (p) { %>
    <a class="post-row" href="/board/<%= p.id %>">
      <% if (p.is_anonymous) { %>
        <%- renderAvatar('basic-12', null, 46) %>
      <% } else { %>
        <%- renderAvatar(p.avatar_id, p.border_id, 46) %>
      <% } %>
      <div class="post-mid">
        <div class="post-title">
          <%- catTag(p.category) %>
          <% if (p.is_hidden) { %><span class="badge badge-lock">숨김</span><% } %>
          <% if (p.is_popular) { %><span class="badge badge-hot">인기</span><% } %>
          <% if (p.admin_picked) { %><span class="badge badge-pick">운영자 추천</span><% } %>
          <%= p.title %>
          <% if (p.image_count > 0) { %><span class="img-mark"><%- icon('image', 14) %></span><% } %>
          <% if (p.comment_count > 0) { %><span class="cmt-count">[<%= p.comment_count %>]</span><% } %>
        </div>
        <div class="post-preview"><%= (p.content_text || p.content).replace(/\s+/g, ' ').slice(0, 60) %></div>
        <div class="post-meta">
          <%= p.is_anonymous ? '익명' : p.nickname %> · <%= timeAgo(p.created_at) %>
        </div>
      </div>
      <div class="post-stats">
        <span><%- icon('comment', 15) %> <%= p.comment_count %></span>
        <span><%- icon('like', 15) %> <%= p.like_count %></span>
      </div>
    </a>
  <% }) %>
</div>

<% if (totalPages > 1) { %>
  <%
    // 페이지가 많아도 링크는 현재 위치 주변 몇 개만 보여준다.
    // 전부 그리면 글이 늘어날수록 목록 아래가 숫자로 뒤덮인다.
    const WINDOW = 2;
    let from = Math.max(1, page - WINDOW);
    let to = Math.min(totalPages, page + WINDOW);
    if (page <= WINDOW + 1) to = Math.min(totalPages, WINDOW * 2 + 1);
    if (page >= totalPages - WINDOW) from = Math.max(1, totalPages - WINDOW * 2);
    const href = (n) => `/board?page=${n}&sort=${sort}`
      + (hot ? '&filter=hot' : '')
      + (category ? '&category=' + encodeURIComponent(category) : '')
      + (q ? '&q=' + encodeURIComponent(q) : '');
  %>
  <nav class="pager" aria-label="페이지 이동">
    <% if (page > 1) { %>
      <a class="page page-nav" href="<%= href(1) %>" aria-label="첫 페이지">«</a>
      <a class="page page-nav" href="<%= href(page - 1) %>" rel="prev" aria-label="이전 페이지">‹</a>
    <% } %>

    <% if (from > 1) { %><span class="page-gap">…</span><% } %>
    <% for (let i = from; i <= to; i++) { %>
      <a class="page <%= i === page ? 'on' : '' %>" href="<%= href(i) %>"
         <%= i === page ? 'aria-current="page"' : '' %>><%= i %></a>
    <% } %>
    <% if (to < totalPages) { %><span class="page-gap">…</span><% } %>

    <% if (page < totalPages) { %>
      <a class="page page-nav" href="<%= href(page + 1) %>" rel="next" aria-label="다음 페이지">›</a>
      <a class="page page-nav" href="<%= href(totalPages) %>" aria-label="마지막 페이지">»</a>
    <% } %>
    <span class="page-info muted"><%= page %> / <%= totalPages %></span>
  </nav>
<% } %>

<%- include('partials/footer') %>
