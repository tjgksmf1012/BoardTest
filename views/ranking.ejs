<%- include('partials/header', { title: '랭킹', active: 'ranking' }) %>

<div class="board-head">
  <div>
    <h1>포인트 랭킹</h1>
    <p class="muted">활동 포인트가 높은 회원 TOP 20이에요. 열심히 활동해서 순위에 도전해보세요!</p>
  </div>
</div>

<div class="card rank-list">
  <% users.forEach(function (u, i) { %>
    <div class="rank-row <%= me && me.id === u.id ? 'me-row' : '' %>">
      <span class="rank-no <%= i < 3 ? 'top' + (i + 1) : '' %>">
        <%= i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : (i + 1) %>
      </span>
      <%- renderAvatar(u.avatar_id, u.border_id, 44) %>
      <div class="post-mid">
        <div class="post-title">
          <%= u.nickname %>
          <% if (u.is_admin) { %><span class="badge badge-notice">운영자</span><% } %>
          <% if (me && me.id === u.id) { %><span class="badge badge-free">나</span><% } %>
        </div>
        <div class="post-meta">게시글 <%= u.post_count %> · 댓글 <%= u.comment_count %></div>
      </div>
      <strong class="accent"><%= u.points.toLocaleString() %>P</strong>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
