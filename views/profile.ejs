<%- include('partials/header', { title: '마이페이지', active: 'profile' }) %>

<div class="profile-top card">
  <div class="profile-avatar"><%- renderAvatar(me.avatar_id, me.border_id, 96) %></div>
  <div class="profile-info">
    <h1>
      <span class="lv-chip" style="background:<%= level.color %>1a;color:<%= level.color %>">Lv.<%= level.level %> <%= level.title %></span>
      <%= me.nickname %>
      <% if (me.is_admin) { %><span class="badge badge-notice">운영자</span><% } %>
    </h1>
    <a href="/points" class="accent big points-link"><%= me.points.toLocaleString() %>P <span class="points-arrow">내역 →</span></a>
    <div class="profile-stats">
      <span>게시글 <strong><%= stats.posts %></strong></span>
      <span>댓글 <strong><%= stats.comments %></strong></span>
      <span>받은 추천 <strong><%= stats.likesReceived %></strong></span>
      <span>출석 <strong><%= stats.attendance %></strong>일</span>
    </div>
  </div>
  <form action="/logout" method="post" class="inline profile-logout">
    <button class="btn btn-ghost btn-sm" type="submit">로그아웃</button>
  </form>
</div>

<div class="ptab-bar">
  <button class="ptab on" type="button" data-target="info">내 정보</button>
  <button class="ptab" type="button" data-target="attendance">출석</button>
  <button class="ptab" type="button" data-target="avatar">아바타 꾸미기</button>
</div>

<div class="ptab-panel on" id="panel-info">

<div class="card next-unlock">
  <% if (next) { %>
    <div class="nu-head">
      <span>다음 해금까지 <strong class="accent"><%= next.remaining.toLocaleString() %>P</strong> 남았어요</span>
      <span class="muted"><%= next.label %> · <%= me.points.toLocaleString() %> / <%= next.need.toLocaleString() %>P</span>
    </div>
    <div class="progress"><div class="progress-fill" style="width: <%= next.percent %>%"></div></div>
  <% } else { %>
    <div class="nu-head"><span>🏆 모든 아바타를 해금했어요! 최고 등급이에요.</span></div>
    <div class="progress"><div class="progress-fill" style="width: 100%"></div></div>
  <% } %>
</div>

<% if (me.is_admin) { %>
  <div class="admin-links">
    <a class="btn btn-ghost" href="/reports"><%- icon('report', 16) %> 신고 관리</a>
    <a class="btn btn-ghost" href="/admin/members"><%- icon('user', 16) %> 회원 관리</a>
  </div>
<% } %>

<div class="my-activity">
  <div class="card">
    <h3 class="mini-title">내가 쓴 글</h3>
    <% if (myPosts.length === 0) { %>
      <div class="empty small">아직 쓴 글이 없어요.</div>
    <% } else { %>
      <ul class="mini-list">
        <% myPosts.forEach(function (p) { %>
          <li><a href="/board/<%= p.id %>">
            <span class="mini-text"><%= p.title %></span>
            <span class="muted">💬 <%= p.comment_count %> · <%= p.created_at.slice(5, 10) %></span>
          </a></li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div class="card">
    <h3 class="mini-title">내가 쓴 댓글</h3>
    <% if (myComments.length === 0) { %>
      <div class="empty small">아직 쓴 댓글이 없어요.</div>
    <% } else { %>
      <ul class="mini-list">
        <% myComments.forEach(function (c) { %>
          <li><a href="/board/<%= c.post_id %>">
            <span class="mini-text"><%= c.content %></span>
            <span class="muted">on <%= c.post_title %></span>
          </a></li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div class="card">
    <h3 class="mini-title">스크랩한 글</h3>
    <% if (myBookmarks.length === 0) { %>
      <div class="empty small">스크랩한 글이 없어요.</div>
    <% } else { %>
      <ul class="mini-list">
        <% myBookmarks.forEach(function (b) { %>
          <li><a href="/board/<%= b.post_id %>">
            <span class="mini-text"><%= b.title %></span>
            <span class="muted"><%= b.is_anonymous ? '익명' : b.nickname %></span>
          </a></li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</div>

<h2 class="section-title">획득한 배지</h2>
<p class="muted">활동으로 얻는 업적이에요. <%= badges.filter(b => b.earned).length %> / <%= badges.length %>개 달성!</p>
<div class="card badge-card">
  <div class="badge-grid">
    <% badges.forEach(function (b) { %>
      <div class="ach <%= b.earned ? 'earned' : 'locked' %>" title="<%= b.desc %>">
        <span class="ach-icon"><%= b.icon %></span>
        <span class="ach-name"><%= b.name %></span>
        <span class="ach-desc muted"><%= b.earned ? b.desc : '🔒 ' + b.desc %></span>
      </div>
    <% }) %>
  </div>
</div>

</div><%# /panel-info %>

<div class="ptab-panel" id="panel-attendance">

<div class="att-grid">
  <div class="card att-card">
    <div class="att-card-head">
      <h2><%= att.year %>년 <%= att.month %>월</h2>
      <% if (att.checkedToday) { %>
        <span class="badge badge-hot">오늘 출석 완료</span>
      <% } else { %>
        <span class="badge badge-lock">오늘 출석 전</span>
      <% } %>
    </div>
    <div class="calendar">
      <% ['일','월','화','수','목','금','토'].forEach(function (d) { %>
        <div class="cal-head"><%= d %></div>
      <% }) %>
      <% for (let i = 0; i < att.firstWeekday; i++) { %><div class="cal-cell empty-cell"></div><% } %>
      <% for (let d = 1; d <= att.daysInMonth; d++) { %>
        <div class="cal-cell <%= att.checkedDays.has(d) ? 'checked' : '' %> <%= d === att.today ? 'today' : '' %>">
          <span class="cal-day"><%= d %></span>
          <% if (att.checkedDays.has(d)) { %><span class="cal-stamp">✓</span><% } %>
        </div>
      <% } %>
    </div>

    <% if (att.checkedToday) { %>
      <button class="btn btn-primary btn-block" disabled>오늘 출석 완료! 내일 또 만나요 ✓</button>
    <% } else { %>
      <form action="/attendance/check" method="post">
        <input type="hidden" name="next" value="/profile">
        <button class="btn btn-primary btn-block" type="submit">출석체크 하고 100P 받기</button>
      </form>
    <% } %>
  </div>

  <div class="card att-side">
    <h2>연속 출석 현황</h2>
    <% if (att.checkedToday) { %>
      <p class="streak-now"><%- icon('flame', 18) %> 현재 <strong><%= att.streak %></strong>일 연속 출석 중</p>
    <% } else if (att.streak > 0) { %>
      <p class="streak-now"><%- icon('flame', 18) %> 어제까지 <strong><%= att.streak %></strong>일 연속</p>
      <p class="muted att-keep">오늘 출석하면 <strong><%= att.streak + 1 %>일째</strong>로 이어져요!</p>
    <% } else { %>
      <p class="streak-now"><%- icon('flame', 18) %> 연속 출석 <strong>0</strong>일</p>
      <p class="muted att-keep">오늘 출석하면 연속 기록이 시작돼요.</p>
    <% } %>
    <ul class="streak-list">
      <li class="<%= att.streak >= 3 ? 'done' : '' %>"><span>3일 연속</span><strong>+500P</strong></li>
      <li class="<%= att.streak >= 7 ? 'done' : '' %>"><span>7일 연속</span><strong>+1,000P</strong></li>
      <li class="<%= att.streak >= 30 ? 'done' : '' %>"><span>30일 연속</span><strong>+3,000P</strong></li>
    </ul>
    <p class="muted">하루 출석하면 100P. 연속 출석이 끊기면 처음부터 다시 시작돼요.</p>
  </div>
</div>

</div><%# /panel-attendance %>

<div class="ptab-panel" id="panel-avatar">

<h2 class="section-title">아바타 해금 가이드</h2>
<p class="muted">게시판 활동 포인트로 다양한 아바타를 열어보세요. 포인트가 기준에 도달하면 자동으로 해금돼요!</p>

<% groups.forEach(function (g) { %>
  <div class="card tier-card">
    <div class="tier-head">
      <h3><%= g.info.label %></h3>
      <% if (g.tier === 'event') { %>
        <span class="badge badge-pick">시즌 한정</span>
      <% } else if (g.info.need > 0) { %>
        <span class="badge <%= me.points >= g.info.need ? 'badge-hot' : 'badge-lock' %>">
          <%= g.info.need.toLocaleString() %>P 해금
        </span>
      <% } else { %>
        <span class="badge badge-free">무료</span>
      <% } %>
      <span class="muted"><%= g.info.desc %></span>
    </div>
    <% if (g.info.need > 0 && me.points < g.info.need) { %>
      <div class="progress tier-progress">
        <div class="progress-fill" style="width: <%= Math.round(me.points / g.info.need * 100) %>%"></div>
      </div>
      <p class="tier-progress-label muted"><%= (g.info.need - me.points).toLocaleString() %>P 더 모으면 해금돼요!</p>
    <% } %>
    <div class="avatar-grid">
      <% g.avatars.forEach(function (a) { %>
        <% if (a.unlocked) { %>
          <form method="post" action="/profile/avatar" class="avatar-pick <%= me.avatar_id === a.id ? 'selected' : '' %>">
            <input type="hidden" name="avatar_id" value="<%= a.id %>">
            <button type="submit" title="<%= a.name %>">
              <%- renderAvatar(a.id, null, 64) %>
              <span class="avatar-name"><%= a.name %></span>
              <% if (me.avatar_id === a.id) { %><span class="using">사용 중</span><% } %>
            </button>
          </form>
        <% } else { %>
          <div class="avatar-pick locked" title="<%= a.name %>">
            <%- renderAvatar(a.id, null, 64) %>
            <span class="lock-overlay">🔒</span>
            <span class="avatar-name"><%= a.name %></span>
            <span class="lock-note">
              <%= a.tier === 'event' ? (a.months.join('·') + '월 오픈') : (a.need.toLocaleString() + 'P 필요') %>
            </span>
          </div>
        <% } %>
      <% }) %>
    </div>
  </div>
<% }) %>

<div class="card tier-card">
  <div class="tier-head">
    <h3>움직이는 테두리</h3>
    <span class="badge <%= me.points >= 20000 ? 'badge-hot' : 'badge-lock' %>">20,000P 해금</span>
    <span class="muted">반짝이는 효과와 애니메이션 느낌의 테두리</span>
  </div>
  <% if (me.points < 20000) { %>
    <div class="progress tier-progress">
      <div class="progress-fill" style="width: <%= Math.round(me.points / 20000 * 100) %>%"></div>
    </div>
    <p class="tier-progress-label muted"><%= (20000 - me.points).toLocaleString() %>P 더 모으면 해금돼요!</p>
  <% } %>
  <div class="avatar-grid">
    <% borders.forEach(function (b) { %>
      <% if (b.unlocked) { %>
        <form method="post" action="/profile/border" class="avatar-pick <%= me.border_id === b.id ? 'selected' : '' %>">
          <input type="hidden" name="border_id" value="<%= b.id %>">
          <button type="submit" title="<%= b.name %>">
            <%- renderAvatar(me.avatar_id, b.id, 64) %>
            <span class="avatar-name"><%= b.name %></span>
            <% if (me.border_id === b.id) { %><span class="using">사용 중</span><% } %>
          </button>
        </form>
      <% } else { %>
        <div class="avatar-pick locked" title="<%= b.name %>">
          <%- renderAvatar(me.avatar_id, b.id, 64) %>
          <span class="lock-overlay">🔒</span>
          <span class="avatar-name"><%= b.name %></span>
          <span class="lock-note">20,000P 필요</span>
        </div>
      <% } %>
    <% }) %>
    <% if (me.border_id) { %>
      <form method="post" action="/profile/border" class="avatar-pick">
        <button type="submit" title="테두리 해제">
          <%- renderAvatar(me.avatar_id, null, 64) %>
          <span class="avatar-name">테두리 없음</span>
        </button>
      </form>
    <% } %>
  </div>
</div>

</div><%# /panel-avatar %>

<script>
  (function () {
    document.documentElement.classList.add('js-tabs');
    var tabs = document.querySelectorAll('.ptab');
    var panels = document.querySelectorAll('.ptab-panel');
    function show(target) {
      tabs.forEach(function (t) { t.classList.toggle('on', t.dataset.target === target); });
      panels.forEach(function (p) { p.classList.toggle('on', p.id === 'panel-' + target); });
    }
    tabs.forEach(function (t) {
      t.addEventListener('click', function () {
        show(t.dataset.target);
        history.replaceState(null, '', '#' + t.dataset.target);
      });
    });
    var open = location.hash.replace('#', '');
    if (open && document.getElementById('panel-' + open)) show(open);
  })();
</script>

<%- include('partials/footer') %>
