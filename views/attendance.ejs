<%- include('partials/header', { title: '출석체크', active: 'attendance' }) %>

<div class="att-head">
  <div>
    <h1>출석체크</h1>
    <p class="muted">매일 출석하고 포인트를 받아보세요!</p>
  </div>
  <span class="att-head-ico" aria-hidden="true"><%- icon('calendar', 46) %></span>
</div>

<%# 상단 요약 — 연속 출석 / 이번 달 / 보유 포인트 %>
<section class="card att-summary">
  <div class="asum">
    <span class="asum-ico"><%- icon('calendar', 20) %></span>
    <span class="asum-label">연속 출석</span>
    <strong class="asum-value"><%= streak %>일</strong>
  </div>
  <div class="asum">
    <span class="asum-ico warm"><%- icon('flame', 20) %></span>
    <span class="asum-label">이번 달 출석</span>
    <strong class="asum-value warm"><%= monthly %>회</strong>
  </div>
  <div class="asum">
    <span class="asum-ico gold"><%- icon('coin', 20) %></span>
    <span class="asum-label">보유 포인트</span>
    <strong class="asum-value"><%= me.points.toLocaleString() %>P</strong>
  </div>
  <a class="asum-link" href="/points"><%- icon('list', 18) %> 포인트 내역 <span aria-hidden="true">›</span></a>
</section>

<%# 30일 연속 출석 챌린지 %>
<section class="card att-challenge">
  <div class="att-sec-head">
    <h2><%- icon('target', 18) %> <%= challenge.days %>일 연속 출석 챌린지</h2>
    <span class="badge badge-notice"><%= challenge.remain === 0 ? '달성' : '진행 중' %></span>
  </div>
  <p class="muted att-sec-desc">
    <%= challenge.days %>일 연속 출석 성공 시 특별 보너스 <%= milestones[milestones.length - 1].points %>P!
  </p>

  <div class="att-progress-top">
    <span class="att-big"><%= challenge.done %></span><span class="att-of"> / <%= challenge.days %>일</span>
    <span class="muted att-remain">
      <% if (challenge.remain > 0) { %>
        <%= challenge.days %>일 연속 출석까지 <strong><%= challenge.remain %>일</strong> 남았어요!
      <% } else { %>
        챌린지를 달성했어요!
      <% } %>
    </span>
  </div>

  <%# 하루 한 칸씩 채워지는 진행바 %>
  <div class="att-blocks" role="img"
       aria-label="<%= challenge.days %>일 중 <%= challenge.done %>일 출석">
    <% for (let d = 1; d <= challenge.days; d++) { %>
      <span class="att-block <%= d <= challenge.done ? 'on' : '' %>"></span>
    <% } %>
  </div>

  <ol class="att-marks">
    <% challenge.marks.forEach(function (m) { %>
      <li class="<%= m.reached ? 'on' : '' %>">
        <span class="am-day"><%= m.days %>일</span>
        <span class="am-point"><%= m.special ? '특별 ' : '' %><%= m.points %>P</span>
        <span class="am-dot" aria-hidden="true"><%= m.reached ? '✓' : '' %></span>
      </li>
    <% }) %>
  </ol>
</section>

<%# 이번 주 출석 도전 %>
<section class="card att-week">
  <div class="att-sec-head">
    <h2><%- icon('calendar', 18) %> <%= week.week %>주차 출석 도전</h2>
    <% if (week.goal) { %>
      <span class="att-gift"><%- icon('gift', 16) %> 보너스 <%= week.goal.points %>P</span>
    <% } %>
  </div>
  <% if (week.goal) { %>
    <p class="muted att-sec-desc"><%= week.goal.days %>일 연속 출석 시 <%= week.goal.points %>P 보너스!</p>
  <% } %>

  <ol class="att-days">
    <% week.days.forEach(function (d) { %>
      <li class="att-day-item <%= d.done ? 'done' : '' %> <%= d.today ? 'today' : '' %>">
        <span class="adi-circle"><%= d.done && !d.today ? '✓' : d.day %></span>
        <span class="adi-label"><%= d.today ? '오늘' : d.day + '일차' %></span>
        <span class="adi-point"><%= d.points %>P</span>
      </li>
    <% }) %>
  </ol>

  <% if (done) { %>
    <div class="att-done-box"><%- icon('calendar', 18) %> 오늘 출석을 완료했어요. 내일 또 만나요!</div>
  <% } else { %>
    <form action="/attendance/check" method="post"><%- csrfField() %>
      <input type="hidden" name="next" value="/attendance">
      <button class="btn btn-primary btn-block att-check-btn" type="submit">
        <%- icon('calendar', 18) %> 오늘 출석체크 하기 (<%= attendPoint %>P 적립)
      </button>
    </form>
  <% } %>
  <p class="muted att-note">※ 매일 00:00 ~ 23:59 사이에 출석체크가 가능합니다.</p>
</section>

<%# 안내 %>
<section class="card att-guide">
  <h2 class="att-guide-head"><%- icon('info', 17) %> 출석체크 안내</h2>
  <ul>
    <li>매일 한 번 출석체크할 수 있으며, <%= attendPoint %>P가 적립됩니다.</li>
    <li><%= milestones[0].days %>일 연속 출석 시 <%= milestones[0].points %>P 보너스가 지급됩니다.</li>
    <li>연속 출석일이 끊기면 다음 날부터 다시 1일차로 시작됩니다.</li>
    <li>하루라도 놓치면 연속 출석이 초기화됩니다.</li>
    <li>부정한 방법으로 포인트를 적립할 경우 회수될 수 있습니다.</li>
  </ul>
  <a class="att-record" href="/profile#attendance">출석 기록 보기 <span aria-hidden="true">›</span></a>
</section>

<%- include('partials/footer') %>
