<%- include('partials/header', { title: '알림', active: null }) %>

<div class="board-head">
  <div>
    <h1>알림</h1>
    <p class="muted">내 글·댓글에 대한 반응과 소식을 모아서 보여드려요.</p>
  </div>
</div>

<div class="card noti-list">
  <% if (items.length === 0) { %>
    <div class="empty">아직 받은 알림이 없어요. 활동을 시작해보세요!</div>
  <% } else { %>
    <% items.forEach(function (n) { %>
      <a class="noti-row <%= n.is_read ? '' : 'unread' %>" href="<%= n.link || '/board' %>">
        <div class="noti-body">
          <p><%= n.message %></p>
          <span class="muted"><%= n.created_at.slice(0, 16) %></span>
        </div>
        <% if (!n.is_read) { %><span class="noti-dot"></span><% } %>
      </a>
    <% }) %>
  <% } %>
</div>

<%- include('partials/footer') %>
