# 서버 환경변수 예시 (복사해서 .env 또는 배포 환경에 설정)

# 세션 서명 키 — 운영에서는 반드시 길고 무작위한 값으로 교체하세요
SESSION_SECRET=change-me-to-a-long-random-string

# 서버 포트 (기본 3000)
PORT=3000

# production 으로 설정 시 쿠키 Secure 적용, 기본키 사용 시 경고
NODE_ENV=development

# ---- 신원(로그인)을 어디서 가져올지 --------------------------------------
# standalone : 자체 아이디/비밀번호 (기본값) — 혼자 띄워서 보여줄 때
# host       : A사이트(커뮤니티를 삽입할 알바채용 사이트)가 넘겨준 회원번호를 신뢰
#              → 커뮤니티에 별도 회원가입이 없어집니다. 자세한 내용은 docs/연동가이드.md
AUTH_MODE=standalone

# --- AUTH_MODE=host 일 때만 필요 ---
# A사이트와 우리만 아는 공유 비밀키 (토큰 서명용). 32자 이상 무작위 값 권장
# HOST_SSO_SECRET=
# A사이트 로그인 화면 주소 (로그인이 필요할 때 이쪽으로 보냅니다)
# HOST_LOGIN_URL=https://a-site.example.com/login
# A사이트 로그아웃 주소 (선택) — 없으면 커뮤니티만 로그아웃합니다
# HOST_LOGOUT_URL=
# 토큰 유효시간(초, 기본 300). 짧을수록 안전합니다
# HOST_SSO_TTL_SEC=300
